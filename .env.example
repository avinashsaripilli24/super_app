# Copy to .env. Anon key comes from `npx supabase status -o env` (ANON_KEY).
# Keep the host as "localhost", not 127.0.0.1: Chrome blocks localhost-origin
# pages from calling 127.0.0.1 (local network access check).
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=

# The app-open and Assets locks are off on the dev server; uncomment to test them.
# Production builds always lock.
# VITE_APP_LOCK=on

# Web Push public key for notifications (README "Notifications"); must match
# VAPID_PUBLIC_KEY in supabase/functions/.env.
VITE_VAPID_PUBLIC_KEY=
